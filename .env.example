# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it holds live credentials.

# ---- Database ----
# Neon Postgres connection URL (used by drizzle-kit and the DB client)
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Pooled Neon connection URL (used by the pooled DB client)
DATABASE_URL_POOLED=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ---- Cloudflare R2 (primary music storage) ----
# Account ID from Cloudflare dashboard; endpoint defaults to https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET=nyimbohub-media
# Optional override if using a custom endpoint
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ---- Legacy Neon Object Storage (existing audioKey values beginning audio/) ----
AWS_ENDPOINT_URL_S3=https://<your-neon-storage-endpoint>
AWS_ACCESS_KEY_ID=replace_with_legacy_storage_access_key
AWS_SECRET_ACCESS_KEY=replace_with_legacy_storage_secret_key
AWS_REGION=eu-central-1
S3_BUCKET=uploads

# ---- Neon Auth ----
NEON_AUTH_URL=https://<your-auth>.neon.tech
# Required for server-side sessions and the /api/auth route; generate a unique secret (32+ characters).
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# ---- Neon API IPv4 workaround ----
# Set to 1 to use a hardcoded IPv4 fallback for the Neon API. Default 0, so
# production uses the normal fetch without any hardcoded IPs.
NEON_IPV4_WORKAROUND=0
