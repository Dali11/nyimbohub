{
  "name": "nyimbohub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=5000' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=5000' next start",
    "lint": "eslint",
    "db:push": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=5000' drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=5000' tsx scripts/migrate.ts",
    "db:seed": "NODE_OPTIONS='--dns-result-order=ipv4first --network-family-autoselection-attempt-timeout=5000' tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
